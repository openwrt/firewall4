table inet fw4
flush table inet fw4

table inet fw4 {
	#
	# Defines
	#

	define cz_ha_devices = { "vh-ha" }
	define cz_ha_subnets = { 10.183.224.0/28 }

	define lan_devices = { "br-lan" }
	define lan_subnets = { 192.168.1.0/24 }

	define wan_devices = { "pppoe-wan" }
	define wan_subnets = { 10.11.12.0/24 }


	#
	# User includes
	#

	include "/etc/nftables.d/*.nft"


	#
	# Filter rules
	#

	chain input {
		type filter hook input priority filter; policy accept;

		iif "lo" accept comment "!fw4: Accept traffic from loopback"

		ct state vmap { established : accept, related : accept } comment "!fw4: Handle inbound flows"
		iifname "vh-ha" jump input_cz_ha comment "!fw4: Handle cz_ha IPv4/IPv6 input traffic"
		iifname "br-lan" jump input_lan comment "!fw4: Handle lan IPv4/IPv6 input traffic"
		iifname "pppoe-wan" jump input_wan comment "!fw4: Handle wan IPv4/IPv6 input traffic"
	}

	chain forward {
		type filter hook forward priority filter; policy drop;

		ct state vmap { established : accept, related : accept } comment "!fw4: Handle forwarded flows"
		iifname "vh-ha" jump forward_cz_ha comment "!fw4: Handle cz_ha IPv4/IPv6 forward traffic"
		iifname "br-lan" jump forward_lan comment "!fw4: Handle lan IPv4/IPv6 forward traffic"
		iifname "pppoe-wan" jump forward_wan comment "!fw4: Handle wan IPv4/IPv6 forward traffic"
		jump handle_reject
	}

	chain output {
		type filter hook output priority filter; policy accept;

		oif "lo" accept comment "!fw4: Accept traffic towards loopback"

		ct state vmap { established : accept, related : accept } comment "!fw4: Handle outbound flows"
		oifname "vh-ha" jump output_cz_ha comment "!fw4: Handle cz_ha IPv4/IPv6 output traffic"
		oifname "br-lan" jump output_lan comment "!fw4: Handle lan IPv4/IPv6 output traffic"
		oifname "pppoe-wan" jump output_wan comment "!fw4: Handle wan IPv4/IPv6 output traffic"
	}

	chain prerouting {
		type filter hook prerouting priority filter; policy accept;
	}

	chain handle_reject {
		meta l4proto tcp reject with tcp reset comment "!fw4: Reject TCP traffic"
		reject with icmpx type port-unreachable comment "!fw4: Reject any other traffic"
	}

	chain input_cz_ha {
		udp dport 53 counter accept comment "!fw4: ubus:container[cn_ha] rule 2"
		jump reject_from_cz_ha
	}

	chain output_cz_ha {
		jump accept_to_cz_ha
	}

	chain forward_cz_ha {
		jump accept_to_wan comment "!fw4: ubus:container[cn_ha] forwarding 1"
		jump reject_to_cz_ha
	}

	chain accept_to_cz_ha {
		meta nfproto ipv4 oifname "vh-ha" ct state invalid counter drop comment "!fw4: Prevent NAT leakage"
		oifname "vh-ha" counter accept comment "!fw4: accept cz_ha IPv4/IPv6 traffic"
	}

	chain reject_from_cz_ha {
		iifname "vh-ha" counter jump handle_reject comment "!fw4: reject cz_ha IPv4/IPv6 traffic"
	}

	chain reject_to_cz_ha {
		oifname "vh-ha" counter jump handle_reject comment "!fw4: reject cz_ha IPv4/IPv6 traffic"
	}

	chain input_lan {
		jump accept_from_lan
	}

	chain output_lan {
		jump accept_to_lan
	}

	chain forward_lan {
		jump accept_to_cz_ha comment "!fw4: Accept lan to cz_ha forwarding"
		jump accept_to_lan
	}

	chain accept_from_lan {
		iifname "br-lan" counter accept comment "!fw4: accept lan IPv4/IPv6 traffic"
	}

	chain accept_to_lan {
		oifname "br-lan" counter accept comment "!fw4: accept lan IPv4/IPv6 traffic"
	}

	chain input_wan {
		jump reject_from_wan
	}

	chain output_wan {
		jump accept_to_wan
	}

	chain forward_wan {
		jump reject_to_wan
	}

	chain accept_to_wan {
		meta nfproto ipv4 oifname "pppoe-wan" ct state invalid counter drop comment "!fw4: Prevent NAT leakage"
		oifname "pppoe-wan" counter accept comment "!fw4: accept wan IPv4/IPv6 traffic"
	}

	chain reject_from_wan {
		iifname "pppoe-wan" counter jump handle_reject comment "!fw4: reject wan IPv4/IPv6 traffic"
	}

	chain reject_to_wan {
		oifname "pppoe-wan" counter jump handle_reject comment "!fw4: reject wan IPv4/IPv6 traffic"
	}


	#
	# NAT rules
	#

	chain dstnat {
		type nat hook prerouting priority dstnat; policy accept;
	}

	chain srcnat {
		type nat hook postrouting priority srcnat; policy accept;
		oifname "vh-ha" jump srcnat_cz_ha comment "!fw4: Handle cz_ha IPv4/IPv6 srcnat traffic"
		oifname "pppoe-wan" jump srcnat_wan comment "!fw4: Handle wan IPv4/IPv6 srcnat traffic"
	}

	chain srcnat_cz_ha {
		meta nfproto ipv4 masquerade comment "!fw4: Masquerade IPv4 cz_ha traffic"
	}

	chain srcnat_wan {
		meta nfproto ipv4 masquerade comment "!fw4: Masquerade IPv4 wan traffic"
	}


	#
	# Raw rules (notrack)
	#

	chain raw_prerouting {
		type filter hook prerouting priority raw; policy accept;
	}

	chain raw_output {
		type filter hook output priority raw; policy accept;
	}


	#
	# Mangle rules
	#

	chain mangle_prerouting {
		type filter hook prerouting priority mangle; policy accept;
	}

	chain mangle_postrouting {
		type filter hook postrouting priority mangle; policy accept;
		oifname "vh-ha" tcp flags syn / syn,fin,rst tcp option maxseg size set rt mtu comment "!fw4: Zone cz_ha IPv4/IPv6 egress MTU fixing"
	}

	chain mangle_input {
		type filter hook input priority mangle; policy accept;
	}

	chain mangle_output {
		type route hook output priority mangle; policy accept;
	}

	chain mangle_forward {
		type filter hook forward priority mangle; policy accept;
		iifname "vh-ha" tcp flags syn / syn,fin,rst tcp option maxseg size set rt mtu comment "!fw4: Zone cz_ha IPv4/IPv6 ingress MTU fixing"
	}
}
-- End --
