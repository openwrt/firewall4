table inet fw4 {
	#
	# Set definitions
	#

	set hosts {
		comment "Destination hosts"
		type ipv4_addr
		elements = {
			10.0.1.1,
			10.0.1.2,
		}
	}

	set pairs {
		comment "Source IP/MAC pairs"
