		meta nfproto ipv4 meta l4proto tcp ip saddr @hosts counter jump accept_to_wan comment "!fw4: Reference with repeated separators"
		meta nfproto ipv4 meta l4proto tcp ip saddr . ether saddr @pairs counter jump accept_to_wan comment "!fw4: Reference with comma separated tokens"
		jump drop_to_lan
	}

	chain drop_from_lan {
		iifname "br-lan" counter drop comment "!fw4: drop lan IPv4/IPv6 traffic"
	}

	chain drop_to_lan {
		oifname "br-lan" counter drop comment "!fw4: drop lan IPv4/IPv6 traffic"
	}

	chain input_wan {
		jump drop_from_wan
	}

	chain output_wan {
		jump drop_to_wan
	}

	chain forward_wan {
