table inet fw4
flush table inet fw4

table inet fw4 {
	#
	# Flowtable
	#

	flowtable ft {
		hook ingress priority 0;
		devices = { "bond0", "br-bd", "br-lan", "br-vl", "br-vl.10", "br-vx", "dk3", "docker0", "eth0", "eth1", "gre1", "ipip1", "mv6", "pppoe-tw4", "pppoe-tw5", "ra", "sit1", "t6", "twg", "vt1", "vt2", "vx", "vxl0", "w1", "w2", "w2.7", "w3", "w3.100", "w3.100.7", "w4", "w5", "w5.7" };
		counter;
	}


	#
	# Defines
	#

	define lan_devices = { "br-lan", "br-bd", "br-vl.10", "br-vx", "vx" }
	define lan_subnets = { 192.168.1.0/24, fd00:1::/64, 192.168.60.0/24, 192.168.10.0/24, fd00:10::/64, 192.168.70.0/24, 10.77.0.0/24 }

	define wan_devices = { "eth1", "w1", "w2.7", "w3.100.7", "pppoe-tw4", "pppoe-tw5", "mv6", "gre1", "ipip1", "sit1", "t6", "twg" }
	define wan_subnets = { 10.0.2.0/24, 10.101.0.0/24, fd01:1::/64, 10.102.0.0/24, fd01:2::/64, 10.103.0.0/24, fd01:3::/64, 10.104.0.1, fe80::1, 10.105.0.1, 10.106.0.0/24, fd01:6::/64, 10.107.0.0/30, 10.108.0.0/30, fd01:9::/64, 10.110.0.0/30, 10.111.0.0/30, fd01:11::/64 }

	define docker_devices = { "docker0" }
	define docker_subnets = {  }


	#
	# User includes
	#

	include "/etc/nftables.d/*.nft"


	#
	# Filter rules
	#

	chain input {
		type filter hook input priority filter; policy drop;

		iif "lo" accept comment "!fw4: Accept traffic from loopback"

		ct state vmap { established : accept, related : accept } comment "!fw4: Handle inbound flows"
		iifname { "br-lan", "br-bd", "br-vl.10", "br-vx", "vx" } jump input_lan comment "!fw4: Handle lan IPv4/IPv6 input traffic"
		iifname { "eth1", "w1", "w2.7", "w3.100.7", "pppoe-tw4", "pppoe-tw5", "mv6", "gre1", "ipip1", "sit1", "t6", "twg" } jump input_wan comment "!fw4: Handle wan IPv4/IPv6 input traffic"
		iifname "docker0" jump input_docker comment "!fw4: Handle docker IPv4/IPv6 input traffic"
	}

	chain forward {
		type filter hook forward priority filter; policy drop;

		meta l4proto { tcp, udp } flow offload @ft;
		ct state vmap { established : accept, related : accept } comment "!fw4: Handle forwarded flows"
		iifname { "br-lan", "br-bd", "br-vl.10", "br-vx", "vx" } jump forward_lan comment "!fw4: Handle lan IPv4/IPv6 forward traffic"
		iifname { "eth1", "w1", "w2.7", "w3.100.7", "pppoe-tw4", "pppoe-tw5", "mv6", "gre1", "ipip1", "sit1", "t6", "twg" } jump forward_wan comment "!fw4: Handle wan IPv4/IPv6 forward traffic"
		iifname "docker0" jump forward_docker comment "!fw4: Handle docker IPv4/IPv6 forward traffic"
	}

	chain output {
		type filter hook output priority filter; policy drop;

		oif "lo" accept comment "!fw4: Accept traffic towards loopback"

		ct state vmap { established : accept, related : accept } comment "!fw4: Handle outbound flows"
		oifname { "br-lan", "br-bd", "br-vl.10", "br-vx", "vx" } jump output_lan comment "!fw4: Handle lan IPv4/IPv6 output traffic"
		oifname { "eth1", "w1", "w2.7", "w3.100.7", "pppoe-tw4", "pppoe-tw5", "mv6", "gre1", "ipip1", "sit1", "t6", "twg" } jump output_wan comment "!fw4: Handle wan IPv4/IPv6 output traffic"
		oifname "docker0" jump output_docker comment "!fw4: Handle docker IPv4/IPv6 output traffic"
	}

	chain prerouting {
		type filter hook prerouting priority filter; policy accept;
	}

	chain handle_reject {
		meta l4proto tcp reject with tcp reset comment "!fw4: Reject TCP traffic"
		reject with icmpx type port-unreachable comment "!fw4: Reject any other traffic"
	}

	chain input_lan {
		jump drop_from_lan
	}

	chain output_lan {
		jump drop_to_lan
	}

	chain forward_lan {
		jump drop_to_lan
	}

	chain drop_from_lan {
		iifname { "br-lan", "br-bd", "br-vl.10", "br-vx", "vx" } counter drop comment "!fw4: drop lan IPv4/IPv6 traffic"
	}

	chain drop_to_lan {
		oifname { "br-lan", "br-bd", "br-vl.10", "br-vx", "vx" } counter drop comment "!fw4: drop lan IPv4/IPv6 traffic"
	}

	chain input_wan {
		jump drop_from_wan
	}

	chain output_wan {
		jump drop_to_wan
	}

	chain forward_wan {
		jump drop_to_wan
	}

	chain drop_from_wan {
		iifname { "eth1", "w1", "w2.7", "w3.100.7", "pppoe-tw4", "pppoe-tw5", "mv6", "gre1", "ipip1", "sit1", "t6", "twg" } counter drop comment "!fw4: drop wan IPv4/IPv6 traffic"
	}

	chain drop_to_wan {
		oifname { "eth1", "w1", "w2.7", "w3.100.7", "pppoe-tw4", "pppoe-tw5", "mv6", "gre1", "ipip1", "sit1", "t6", "twg" } counter drop comment "!fw4: drop wan IPv4/IPv6 traffic"
	}

	chain input_docker {
		jump drop_from_docker
	}

	chain output_docker {
		jump drop_to_docker
	}

	chain forward_docker {
		jump drop_to_docker
	}

	chain drop_from_docker {
		iifname "docker0" counter drop comment "!fw4: drop docker IPv4/IPv6 traffic"
	}

	chain drop_to_docker {
		oifname "docker0" counter drop comment "!fw4: drop docker IPv4/IPv6 traffic"
	}


	#
	# NAT rules
	#

	chain dstnat {
		type nat hook prerouting priority dstnat; policy accept;
	}

	chain srcnat {
		type nat hook postrouting priority srcnat; policy accept;
		oifname { "eth1", "w1", "w2.7", "w3.100.7", "pppoe-tw4", "pppoe-tw5", "mv6", "gre1", "ipip1", "sit1", "t6", "twg" } jump srcnat_wan comment "!fw4: Handle wan IPv4/IPv6 srcnat traffic"
	}

	chain srcnat_wan {
		meta nfproto ipv4 masquerade comment "!fw4: Masquerade IPv4 wan traffic"
	}


	#
	# Raw rules (notrack)
	#

	chain raw_prerouting {
		type filter hook prerouting priority raw; policy accept;
	}

	chain raw_output {
		type filter hook output priority raw; policy accept;
	}


	#
	# Mangle rules
	#

	chain mangle_prerouting {
		type filter hook prerouting priority mangle; policy accept;
	}

	chain mangle_postrouting {
		type filter hook postrouting priority mangle; policy accept;
	}

	chain mangle_input {
		type filter hook input priority mangle; policy accept;
	}

	chain mangle_output {
		type route hook output priority mangle; policy accept;
	}

	chain mangle_forward {
		type filter hook forward priority mangle; policy accept;
	}
}
