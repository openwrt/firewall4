Testing which sets a load names as filled by the ruleset, which are the
ones that sbin/fw4 lists with their elements: those with entries or with
a file to load them from, not the ones that get filled later on.

-- Testcase --
{%
	let main = "./root/usr/share/firewall4/main.uc";

	// load the ruleset, then let the fixtures below after/ take effect
	render(() => include(main, {
		getenv: (name) => (name == 'ACTION') ? 'start' : null
	}));

	print(require('fs').readfile('/var/run/fw4.sets'));

	unshift(MOCK_SEARCH_PATH, `${MOCK_SEARCH_PATH[0]}/after`);

	include(main, {
		getenv: (name) => (name == 'ACTION') ? 'refresh' : null,
		exit: (code) => print(`exit ${code}\n`)
	});
%}
