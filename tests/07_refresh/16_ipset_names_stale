Testing that a refresh asks for a reload when the file with the names of
the sets to list does not name the sets that the ruleset fills, as it is
the case after that file could not be written.

-- Testcase --
{%
	let main = "./root/usr/share/firewall4/main.uc";

	// load the ruleset, then let the fixtures below after/ take effect
	render(() => include(main, {
		getenv: (name) => (name == 'ACTION') ? 'start' : null
	}));

	require('fs').open('/var/run/fw4.sets', 'w').write('other\n');

	unshift(MOCK_SEARCH_PATH, `${MOCK_SEARCH_PATH[0]}/after`);

	include(main, {
		getenv: (name) => (name == 'ACTION') ? 'refresh' : null,
		exit: (code) => print(`exit ${code}\n`)
	});
%}
